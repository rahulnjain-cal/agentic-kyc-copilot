# ==============================================================================
# Arthashastra Agentic KYC & Entity Resolution Copilot — Environment Template
# Copy to .env for local development. NEVER commit real secrets to Git.
# In production, secrets are loaded from Google Cloud Secret Manager.
# ==============================================================================

# --- Sovereign Region & GCP Project ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west2
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Model Routing (Gemini 4 Neon / Hydrogen / Pro) ---
KYC_MODEL_NEON=gemini-4-neon
KYC_MODEL_HYDROGEN=gemini-4-hydrogen
KYC_MODEL_PRO=gemini-2.5-pro

# --- Secret Manager (Production) or Local Fallback (Dev/CI only) ---
ENABLE_SECRET_MANAGER=false
GEMINI_API_KEY_SECRET_NAME=kyc-copilot-gemini-api-key
REGISTRY_MCP_TOKEN_SECRET_NAME=kyc-copilot-registry-mcp-token
# For local non-Vertex testing only (leave blank in Git):
# GOOGLE_API_KEY=

# --- Persistent Storage & RAG Adapters ---
KYC_STORAGE_BACKEND=sqlite
KYC_SQLITE_PATH=.adk/smriti_digital_twin.sqlite3
# Production adapters (used when KYC_STORAGE_BACKEND=gcp):
# CLOUD_SQL_CONNECTION_NAME=project:europe-west2:kyc-digital-twin
# VERTEX_AI_SEARCH_DATASTORE_ID=kyc-governance-policy-datastore

# --- Context Compaction & Memory ---
KYC_COMPACTION_TOKEN_THRESHOLD=12000
KYC_COMPACTION_RETENTION_EVENTS=6

# --- Security, Observability & PII Redaction ---
ENABLE_CLOUD_DLP=false
ENABLE_CLOUD_TRACE=false
KYC_LOG_LEVEL=INFO
KYC_CHECKER_APPROVAL_SECRET_NAME=kyc-copilot-checker-approval-key
